{
  "name": "@lsby/writing-style-benchmark",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "check:all": "pnpm check && pnpm lint && pnpm format:check",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.ts\" \"tests/**/*.ts\" \"docs/**/*.md\" README.md AGENTS.md package.json eslint.config.mjs .prettierrc --ignore-unknown --no-error-on-unmatched-pattern",
    "format:check": "prettier --check \"src/**/*.ts\" \"scripts/**/*.ts\" \"tests/**/*.ts\" \"docs/**/*.md\" README.md AGENTS.md package.json eslint.config.mjs .prettierrc --ignore-unknown --no-error-on-unmatched-pattern",
    "lint": "eslint src scripts tests --no-error-on-unmatched-pattern",
    "lint:fix": "eslint src scripts tests --fix --no-error-on-unmatched-pattern",
    "mcp": "tsx src/mcp.ts",
    "prepare": "husky",
    "start": "tsx src/run.ts",
    "test": "tsx --test tests/*.test.ts",
    "tidy:all": "pnpm lint:fix && pnpm format && pnpm check:all"
  },
  "lint-staged": {
    "{README.md,AGENTS.md,docs/**/*.md,package.json,eslint.config.mjs,.prettierrc}": "prettier --write",
    "{src,scripts,tests}/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@modelcontextprotocol/server": "2.4.0",
    "csv-parse": "^6.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "@lsby/eslint-config": "^0.5.6",
    "@lsby/eslint-plugin": "^0.2.1",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.2",
    "eslint-plugin-jsdoc": "^62.0.0",
    "eslint-plugin-sort-class-members": "^1.21.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "prettier": "^3.7.4",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-packagejson": "^2.5.20",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.52.0"
  },
  "packageManager": "pnpm@9.5.0"
}
